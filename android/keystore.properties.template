# Production signing configuration for Tap & Pay / AuthePay.
#
# THIS FILE IS A TEMPLATE ONLY. Do NOT put real secrets here.
# Copy this file to keystore.properties (which is git-ignored) and fill in real values.
#
# To generate a production keystore (run once, keep OFF shared machines/Git):
#   "%JAVA_HOME%\bin\keytool" -genkeypair -v -keystore release.keystore ^
#     -alias tapandpay -keyalg RSA -keysize 2048 -validity 10000
#
# Then set the values below:
storeFile=release.keystore
storePassword=YOUR_STORE_SECRET
keyAlias=tapandpay
keyPassword=YOUR_KEY_SECRET
