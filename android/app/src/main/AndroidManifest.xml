<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BANK GRADE PERMISSIONS -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        CAMERA — used only for the authorised QR workflows described in
        directive section 14: payment QR, payment-reference QR, merchant QR,
        receipt QR, onboarding documents and sandbox test tokens.

        The camera is NEVER used to capture a card number, expiry or CVV.
        There is no card-scanning ("scan my card") path in this app.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        NFC HARDWARE
        Declared as NOT required so the app still installs and runs on
        devices and emulators without NFC. The absence of an NFC reader is
        detected at runtime by NfcReaderProvider and surfaced to the merchant
        as an explanatory "cannot accept contactless payments" state, rather
        than as a silent failure at the counter.

        HCE (host card emulation) is intentionally NOT declared: AuthePay
        Tap & Pay is a card *reader*, not a card *emulator*.
    -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".AuthePayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            NOTE on Host Card Emulation:
            An earlier draft of this manifest registered a HOST_APDU_SERVICE
            that advertised the Visa/Mastercard contactless payment AIDs.
            That service belongs to a consumer card-emulation app (Google-Pay
            style), not a merchant acceptance app. AuthePay Tap & Pay reads
            cards; it does not emulate them. Advertising payment AIDs without
            scheme certification would also have been a serious bank-submission
            red flag. The service was therefore removed.
        -->

        <!-- KEEP YOUR FILE PROVIDER -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>